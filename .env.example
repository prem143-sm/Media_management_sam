# Admin account. The user ID is the only login credential.
ADMIN_USERNAME=admin
AUTH_SECRET=

# Media is managed directly in prem143-sm/SamsBday, branch main.
# The public repository can be viewed without a token; add/delete needs write access.
GITHUB_OWNER=prem143-sm
GITHUB_REPOSITORY=SamsBday
GITHUB_BRANCH=main
GITHUB_TOKEN=

# Required to add photos and music through private upload staging.
BLOB_READ_WRITE_TOKEN=
