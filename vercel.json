{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/auth.ts": {
      "includeFiles": "src/server/**"
    },
    "api/library.ts": {
      "includeFiles": "src/server/**",
      "maxDuration": 60
    },
    "api/media.ts": {
      "includeFiles": "src/server/**",
      "maxDuration": 60
    },
    "api/upload-token.ts": {
      "includeFiles": "src/server/**"
    }
  }
}
